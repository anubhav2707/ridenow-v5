{
  "name": "ridenow-v5",
  "version": "0.1.0",
  "private": true,
  "description": "RideNow v5 — rider + driver ride-hailing product (walking skeleton).",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "db:migrate": "pnpm --filter @ridenow/db migrate",
    "db:seed": "pnpm --filter @ridenow/db seed",
    "db:reset": "tsx scripts/reset.ts",
    "manifest:check": "node scripts/check-manifests.mjs"
  },
  "devDependencies": {
    "@ridenow/config": "workspace:*",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
