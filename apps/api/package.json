{
  "name": "@ridenow/api",
  "version": "0.0.0",
  "private": true,
  "description": "RideNow API — NestJS on the Fastify adapter. Ports-and-adapters walking skeleton: /health readiness, a faked core-loop over mock providers, and a stub live-tracking gateway.",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest --config jest.config.cjs"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-fastify": "10.4.22",
    "@nestjs/platform-socket.io": "10.4.22",
    "@nestjs/terminus": "10.3.0",
    "@nestjs/websockets": "10.4.22",
    "@ridenow/db": "workspace:*",
    "@ridenow/shared-types": "workspace:*",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.22",
    "@ridenow/config": "workspace:*",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.43",
    "jest": "29.7.0",
    "ts-jest": "29.4.11",
    "tsx": "4.23.0",
    "typescript": "5.9.3"
  }
}
