# ---------------------------------------------------------------------------
# RideNow v5 — environment template.
# Copy to `.env` for local dev:  cp .env.example .env
# NO real secrets live in this file or in `.env` under version control.
# ---------------------------------------------------------------------------

# Node runtime
NODE_ENV=development

# API server
PORT=3000

# Postgres + PostGIS. Matches docker-compose.yml service `db`.
# The reset script REFUSES to run unless the host is local (see scripts/reset.ts).
DATABASE_URL=postgres://ridenow:ridenow@localhost:5432/ridenow

# ---------------------------------------------------------------------------
# Provider ports. Default to deterministic MOCK adapters so the core loop runs
# end-to-end with zero secrets. Swap to `twilio` / `stripe` / `osm` later.
# ---------------------------------------------------------------------------
OTP_PROVIDER=mock
PAYMENT_PROVIDER=mock
GEO_PROVIDER=mock

# Real provider credentials — intentionally BLANK in the template.
# Only consumed when the matching *_PROVIDER above is switched off `mock`.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Keyless OpenStreetMap endpoints (deferred to the geo story; defaults are the
# public demo servers — replace with self-hosted OSRM/Nominatim later).
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Web apps (Vite) — point the browser bundles at the local API.
VITE_API_BASE_URL=http://localhost:3000
