# RideNow v5 — copy to .env for local dev. NO real secrets belong in this file.

# --- Core ---
# Local Postgres+PostGIS (see docker-compose.yml). Inside compose the API uses host "db".
DATABASE_URL=postgres://ridenow:ridenow@localhost:5432/ridenow
PORT=3000

# --- Provider selection (ports-and-adapters) ---
# Each external dependency has a deterministic mock adapter as the default so the
# faked core loop runs with zero secrets. Swap to "real" once the feature story
# wires the real adapter + provisions its credentials.
OTP_PROVIDER=mock
PAYMENT_PROVIDER=mock
GEO_PROVIDER=mock

# --- Twilio (OTP) — leave blank in dev; the mock adapter logs the code instead ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Stripe (payments, test mode) — leave blank in dev; the fake adapter is used ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Geo (OpenStreetMap, keyless) — deferred self-hosting; mock adapter by default ---
OSRM_BASE_URL=
NOMINATIM_BASE_URL=
