# ---------------------------------------------------------------------------
# RideNow v5 — example environment. Copy to `.env` (which is gitignored).
# NO REAL SECRETS are committed. Provider flags default to `mock` so the whole
# stack boots and the faked core loop runs with zero external credentials.
# ---------------------------------------------------------------------------

# Postgres + PostGIS (matches docker-compose.yml)
DATABASE_URL=postgres://ridenow:ridenow@localhost:5432/ridenow

# API
PORT=3000
NODE_ENV=development

# Provider mode: `mock` (default, deterministic, keyless) or `real` (deferred).
OTP_PROVIDER=mock
PAYMENT_PROVIDER=mock
GEO_PROVIDER=mock

# Real providers — left blank in the skeleton; wired in later feature stories.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Web apps — base URL of the API they call.
VITE_API_BASE_URL=http://localhost:3000
