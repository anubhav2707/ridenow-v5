# ---------------------------------------------------------------------------
# RideNow v5 — example environment. Copy to `.env` for local dev.
# NO REAL SECRETS are committed. The real `.env` is gitignored.
# ---------------------------------------------------------------------------

# API listen port
PORT=3000

# Postgres + PostGIS connection. `db` is the docker-compose service host;
# use localhost when running the API outside compose.
DATABASE_URL=postgres://ridenow:ridenow@localhost:5432/ridenow

# ---------------------------------------------------------------------------
# Provider mode flags. Default to `mock` so the whole stack runs on localhost
# with zero secrets. Flip to `real` only once the corresponding adapter and
# its credentials land in a later feature story (ports-and-adapters swap).
# ---------------------------------------------------------------------------
OTP_PROVIDER=mock
PAYMENT_PROVIDER=mock
GEO_PROVIDER=mock

# ---------------------------------------------------------------------------
# Real-provider credentials — intentionally BLANK in the scaffold. Populate
# only in a real `.env` (never committed) when swapping a provider to `real`.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
