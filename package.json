{
  "name": "ridenow-v5",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:migrate": "pnpm --filter @ridenow/db run migrate",
    "db:seed": "pnpm --filter @ridenow/db run seed",
    "db:reset": "tsx scripts/reset.ts"
  },
  "devDependencies": {
    "@ridenow/config": "workspace:*",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
