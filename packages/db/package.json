{
  "name": "@ridenow/db",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "reset": "tsx src/reset.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "drizzle-orm": "0.38.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@ridenow/config": "workspace:*",
    "@types/node": "20.19.43",
    "drizzle-kit": "0.30.6",
    "eslint": "9.39.4",
    "tsx": "4.23.0",
    "typescript": "5.9.3"
  }
}
